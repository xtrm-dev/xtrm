# xtrm Console v2 (packages/xtrm-app) — tailnet-only, supervised.
#
# Route:  https://<host>.ts.net:8446  --tailscale serve-->  http://127.0.0.1:5178
# Source: %h/.xtrm/console-v2 — a clone PINNED to a detached commit that is on
#         `origin/main`, deliberately outside ~/dev so `xt worktree reap` can
#         never touch it (a linked worktree would be discovered by
#         `xt worktree reap --all-repos --roots ~/dev`).
#
# Remotes in the clone: origin = github.com/xtrm-dev/xtrm, local = ~/dev/xtrm.
#
# UI and CLI are the SAME revision: the bridge runs this checkout's `sb`
# (packages/substrate/cli/sb-ux.ts, tracked executable, Node 24 runs the TS).
# The npm-published `sb` is older than this revision and rejects
# `issue query --project`, which the board read model needs.
#
# Update (a restart is the deploy):
#   git -C %h/.xtrm/console-v2 fetch origin
#   git -C %h/.xtrm/console-v2 checkout --detach origin/main
#   cd %h/.xtrm/console-v2/packages/xtrm-app && npm ci
#   cd %h/.xtrm/console-v2/packages/research && ./.venv/bin/pip install -e '.[dev]'
#   systemctl --user restart xtrm-console-v2.service
#
# Node is pinned by absolute path on purpose: a systemd user unit has no nvm on
# PATH. Changing the nvm version means editing PATH here.
#
# The four research settings are resolved by scripts/research-dev.mjs for this
# checkout and printed on start (release identity). It refuses to start if the
# CLI does not belong to this checkout or lacks a read verb the UI calls.

[Unit]
Description=xtrm Console v2 (xtrm-app, tailnet-only via tailscale serve :8446)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.xtrm/console-v2/packages/xtrm-app
ExecStart=%h/.nvm/versions/node/v24.15.0/bin/npm run research:dev -- --host 127.0.0.1 --port 5178 --strictPort
Environment=PATH=%h/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=XTRM_SB_BIN=%h/.xtrm/console-v2/packages/substrate/cli/sb-ux.ts
Environment=XTRM_CONSOLE_URL=http://127.0.0.1:3030
Restart=always
RestartSec=3
MemoryMax=2G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
