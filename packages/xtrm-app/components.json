{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "src/components",
    "ui": "src/components/registry",
    "lib": "src/lib",
    "utils": "src/lib/utils",
    "hooks": "src/hooks"
  },
  "registries": {
    "@spectrumui": "https://ui.spectrumhq.in/r/{name}.json",
    "@agents-ui": "https://livekit.io/ui/r/{name}.json",
    "@reui": "https://reui.io/r/{name}.json"
  }
}