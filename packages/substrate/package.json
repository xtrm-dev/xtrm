{
  "name": "@jaggerxtrm/substrate",
  "version": "0.3.2",
  "description": "Durable work substrate: issue graph over SQLite/WAL (library-first; sb CLI consumes this). Published copies ship prebuilt JavaScript and run on Node >=24 or Bun >=1.3; from a source checkout the entry points are TypeScript and run directly, with no build step.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "sb": "cli/sb-ux.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "substrate",
    "xtrm"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi/extension.ts"
    ]
  },
  "files": [
    "src",
    "cli",
    "hooks",
    "integrations",
    "skills",
    "plugin",
    "docs",
    ".claude-plugin/marketplace.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "node scripts/release.mjs --publish",
    "release:verify": "node scripts/release.mjs --verify",
    "prepublishOnly": "node -e \"console.error('release: publishing this directory would ship a TypeScript manifest that crashes under Node. Run: npm run release (it packs, verifies and publishes the JavaScript artifact).'); process.exit(1)\"",
    "test": "node scripts/test-tmp-guard.mjs",
    "test:suite": "node --import ./tests/hermetic-env.ts --test tests/*.test.ts",
    "test:bun": "bun tests/bun-acceptance.ts",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/changelog-update.mjs --tag v$npm_package_version && node scripts/sync-plugin-version.mjs && git add CHANGELOG.md plugin/substrate/.claude-plugin/plugin.json",
    "changelog": "node scripts/changelog-update.mjs",
    "changelog:check": "node scripts/changelog-update.mjs --check",
    "preversion": "node scripts/changelog-update.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
