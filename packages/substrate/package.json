{
  "name": "@jaggerxtrm/substrate",
  "version": "0.1.1",
  "description": "Durable work substrate: issue graph over SQLite/WAL (library-first; sb CLI consumes this)",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "sb": "cli/sb.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "substrate",
    "xtrm"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi/extension.ts"
    ]
  },
  "files": [
    "src",
    "cli",
    "integrations",
    "skills",
    "plugin",
    ".claude-plugin/marketplace.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:bun": "bun tests/bun-acceptance.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "typebox": "^1.3.7",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  }
}
