{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation.schema.json",
  "title": "Annotation \u2014 one append-only row in annotations.jsonl",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "xtrm-research-annotation/v1"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "conclusion",
        "caveat",
        "superseded_by",
        "invalid_reason",
        "evidence_status",
        "result_summary"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "result_summary": {
      "type": "object",
      "description": "Structured post-evidence result (kind=result_summary only). The prose `text` is optional for this kind because plain_language is the headline; every other semantic output is structured here.",
      "properties": {
        "plain_language": {
          "type": "string",
          "minLength": 1
        },
        "supported_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "plain_language",
        "supported_claims",
        "unsupported_claims",
        "caveats",
        "decision"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "exploratory",
        "reproducible",
        "validated",
        "regression",
        "superseded",
        "invalid"
      ]
    }
  },
  "required": [
    "schema_version",
    "author",
    "timestamp",
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "result_summary"
            }
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evidence_status"
          }
        }
      },
      "then": {
        "required": [
          "evidence_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result_summary"
          }
        }
      },
      "then": {
        "required": [
          "result_summary",
          "evidence_status"
        ]
      }
    }
  ]
}
