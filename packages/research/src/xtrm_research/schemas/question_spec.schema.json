{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtrm-research/question-spec/v1",
  "title": "QuestionSpec — a System One judgment definition",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "type": { "type": "string", "enum": ["choice", "score", "noul"] },
    "instructions": { "type": "string", "minLength": 1 },
    "criteria": {},
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required for type=choice; the option values a Choice answer may take."
    },
    "legend": {
      "type": "object",
      "description": "Required for type=score; maps level numbers to a human-readable label.",
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["id", "version", "content_hash", "type", "instructions", "criteria"],
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["options"] }
    },
    {
      "if": { "properties": { "type": { "const": "score" } } },
      "then": { "required": ["legend"] }
    }
  ]
}
