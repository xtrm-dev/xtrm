{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtrm-research/evaluator/v1",
  "title": "Evaluator definition",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": {
      "type": "string",
      "enum": ["deterministic", "statistical", "model_judge", "specialist", "outcome"]
    },
    "config": { "type": "object" },
    "code_revision": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "prompt_ref": { "type": "string" }
  },
  "required": ["id", "version", "content_hash", "kind", "config", "code_revision"]
}
