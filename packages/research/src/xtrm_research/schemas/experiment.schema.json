{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.json",
  "title": "Experiment \u2014 one research question over one workload version with N variants",
  "type": "object",
  "$defs": {
    "chart_spec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "datasets": {
          "type": "array",
          "description": "Named datasets this chart references. Each must be one of the experiment's own named_datasets \u2014 never a URL data source.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "schema_version",
        "title",
        "description",
        "datasets"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ]
      }
    },
    "named_datasets": {
      "type": "array",
      "description": "The complete set of named (non-URL) datasets this experiment's chart_specs may reference \u2014 usually metric names.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legend": {
      "type": "object",
      "description": "Maps every named dataset and variant id used by this experiment to a human-readable label. Completeness is enforced by validate(), not by this schema alone.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "chart_specs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chart_spec"
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Domain-specific status vocabulary this object uses, if any. Each value must have a legend entry."
    },
    "label_values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Domain-specific label vocabulary this object uses, if any (e.g. choice-question option values). Each value must have a legend entry."
    }
  },
  "required": [
    "id",
    "version",
    "content_hash",
    "workload",
    "description",
    "hypothesis",
    "variants",
    "named_datasets",
    "legend",
    "chart_specs"
  ]
}
