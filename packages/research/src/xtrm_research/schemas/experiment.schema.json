{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtrm-research/experiment/v1",
  "title": "Experiment — one research question over one workload version with N variants",
  "type": "object",
  "$defs": {
    "chart_spec": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "datasets": {
          "type": "array",
          "description": "Named datasets this chart references. Never a URL data source.",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["id", "schema_version", "title", "description", "datasets"],
      "not": {
        "properties": {
          "datasets": {
            "contains": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://" }
          }
        },
        "required": ["datasets"]
      }
    }
  },
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "workload": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["id", "version"]
    },
    "description": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        },
        "required": ["id", "version"]
      }
    },
    "legend": {
      "type": "object",
      "description": "Maps every metric name, variant id, label value and status used by this experiment to a human-readable label. Completeness is enforced by the registry loader, not by this schema alone.",
      "additionalProperties": { "type": "string" }
    },
    "chart_specs": {
      "type": "array",
      "items": { "$ref": "#/$defs/chart_spec" }
    }
  },
  "required": [
    "id", "version", "content_hash", "workload", "description", "hypothesis",
    "variants", "legend", "chart_specs"
  ]
}
