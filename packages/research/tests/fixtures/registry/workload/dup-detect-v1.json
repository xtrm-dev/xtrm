{
  "id": "dup-detect",
  "version": "v1",
  "description": "Fixture workload for duplicate-pair detection.",
  "sample_provider": "tests.fixtures.samples:synthetic_pairs",
  "runner_kind": "system_one",
  "required_capabilities": ["text_compare"],
  "input_schema": {"type": "object"},
  "output_schema": {"type": "object"},
  "questions": [{"id": "dup-check", "version": "v1"}],
  "observers": [],
  "evaluators": [{"id": "exact-match", "version": "v1"}],
  "default_metrics": ["accuracy"],
  "legend": {
    "accuracy": "fraction of samples whose predicted duplicate flag matched the label",
    "dup-check": "does the System One model judge the pair a duplicate?"
  }
}
