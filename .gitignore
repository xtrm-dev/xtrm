# Node / package managers
node_modules/
.pnpm-store/
.pnp.*
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Obsidian — track config + plugins under docs/.obsidian/, but never per-machine UI state.
# Per-vault noise patterns live in docs/.obsidian/.gitignore (see that file).
.trash/

# Local env
.env
.env.local
.env.*.local

# Worktree / agent runtime
.xtrm/
.specialists/
.wolf/
.beads/
.pi/

# Syncthing
*.sync-conflict-*
.claude/
# productivity (local working memory + dashboard)
/CLAUDE.md
/TASKS.md
/dashboard.html
/memory/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.smoke/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# xtrm runtime state (per-machine, do not track)
.xtrm/skills/state.json
.xtrm/worktrees/
.xtrm/cache/
.xtrm/statusline-claim
.pi/skills/
