# Node / package managers
node_modules/
.pnpm-store/
.pnp.*
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Obsidian — track config + plugins under docs/.obsidian/, but never per-machine UI state.
# Per-vault noise patterns live in docs/.obsidian/.gitignore (see that file).
.trash/

# Local env
.env
.env.local
.env.*.local

# Worktree / agent runtime
# Keep .xtrm runtime state ignored, but allow the board-audit interchange tree
# to be versioned for GitHub-backed human/agent handoff.
.xtrm/*
!.xtrm/board-audit/
!.xtrm/board-audit/**
.specialists/
.wolf/
.beads/
.pi/

# Syncthing
*.sync-conflict-*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

.specialists/jobs/
.specialists/ready/
.specialists/db/*.db
.specialists/db/*.db-wal
.specialists/db/*.db-shm
.worktrees/xtrm-2m3.10/xtrm-2m3.10-executor/
