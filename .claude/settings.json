{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/quality-check.cjs\"",
            "timeout": 30000,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/quality-check.py\"",
            "timeout": 30000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Bash|Grep|Read|Glob"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/service-skills/scripts/drift_detector.py\" check-hook",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/xtrm-tool-logger.mjs\"",
            "timeout": 3000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/specialists-complete.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/specialists-memory-cache-sync.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/worktree-boundary.mjs\"",
            "timeout": 2000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/specialists-agent-guard.mjs\"",
            "timeout": 2000,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/service-skills/scripts/skill_activator.py\"",
            "type": "command"
          }
        ],
        "matcher": "Read|Write|Edit|Glob|Grep|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/using-xtrm-reminder.mjs\"",
            "type": "command"
          },
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/quality-check-env.mjs\"",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/service-skills/scripts/cataloger.py\"",
            "type": "command"
          },
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.xtrm/hooks/xtrm-session-logger.mjs\"",
            "timeout": 3000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/specialists-session-start.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/specialists-complete.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
