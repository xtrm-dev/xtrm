{
  "mcpServers": {
    "github-grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "gitnexus": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "gitnexus",
        "mcp"
      ],
      "env": {}
    },
    "specialists": {
      "command": "specialists",
      "args": []
    },
    "shadcn": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "cd packages/xtrm-app && exec npx -y shadcn@latest mcp"]
    },
    "spectrum-ui": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@spectrumui/mcp"]
    },
    "livekit-docs": {
      "type": "http",
      "url": "https://docs.livekit.io/mcp"
    }
  }
}
